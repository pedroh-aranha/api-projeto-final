generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Usuario {
  id        Int      @id @default(autoincrement())
  nome      String
  email     String   @unique

  @@map("usuarios")
}

model modalidades {
  id       Int       @id @default(autoincrement())
  nome     String    @unique
  modalidades modalidades[]

  @@map("categorias")
}

model turmas {
  id          Int       @id @default(autoincrement())
  diasemana      String
  horario   DateTime
  instrutor  String
  vagas      String    @default("Ativa")
  status Int

  @@map("chamados")
}